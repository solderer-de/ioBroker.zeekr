{
  "i18n": true,
  "type": "tabs",
  "items": {
    "access": {
      "type": "panel",
      "label": "Access",
      "items": {
        "_hint": {
          "type": "staticText",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "text": "Enter the Zeekr account. EU accounts (com.zeekr.overseas) need region EU. See README for details."
        },
        "username": {
          "type": "text",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "Username (email)",
          "help": "Tip: share the car with a second account to avoid session conflicts (error 079021)."
        },
        "password": {
          "type": "password",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "Password"
        },
        "countryCode": {
          "type": "text",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "default": "AU",
          "label": "Country code (e.g. DE, AU)",
          "help": "EU countries suggest region EU automatically."
        },
        "extractRegion": {
          "type": "select",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "default": "EM",
          "label": "Region",
          "help": "EU accounts need EU. “Invalid access key” almost always means wrong region.",
          "options": [
            {
              "label": "EM – Emerging Markets",
              "value": "EM"
            },
            {
              "label": "EU – Europe",
              "value": "EU"
            },
            {
              "label": "SEA – Southeast Asia",
              "value": "SEA"
            },
            {
              "label": "CN – China",
              "value": "CN"
            }
          ]
        },
        "autoExtractSecrets": {
          "type": "checkbox",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "label": "Extract missing keys automatically on start"
        },
        "apkBasePath": {
          "type": "text",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "APK base.apk (path on host)",
          "help": "e.g. /opt/iobroker/iobroker-data/zeekr/base.apk"
        },
        "apkArm64Path": {
          "type": "text",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "APK split arm64 (path)",
          "help": "Contains the HMAC keys. Not the xxhdpi file."
        },
        "secretsJsonPath": {
          "type": "text",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "label": "Or: zeekr_secrets.json path (instead of APKs)"
        }
      }
    },
    "keys": {
      "type": "panel",
      "label": "Keys",
      "items": {
        "_hint": {
          "type": "staticText",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "text": "Filled in automatically. Only enter manually if extraction is impossible."
        },
        "hmacAccessKey": {
          "type": "password",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "HMAC Access Key"
        },
        "hmacSecretKey": {
          "type": "password",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "HMAC Secret Key"
        },
        "passwordPublicKey": {
          "type": "password",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "Password Public Key"
        },
        "prodSecret": {
          "type": "password",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "Prod Secret"
        },
        "prodSecretCandidates": {
          "type": "text",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "label": "Prod secret candidates (comma separated)",
          "help": "If several are listed in zeekr_secrets.json, paste them all here."
        },
        "vinKey": {
          "type": "password",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "VIN Key"
        },
        "vinIv": {
          "type": "password",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "VIN IV"
        }
      }
    },
    "advanced": {
      "type": "panel",
      "label": "Advanced",
      "items": {
        "_hint": {
          "type": "staticText",
          "xs": 12,
          "sm": 12,
          "md": 12,
          "lg": 12,
          "xl": 12,
          "text": "Only needed for problems. Live hints: info.lastErrorHint."
        },
        "pollingInterval": {
          "type": "number",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "default": 300,
          "min": 30,
          "step": 30,
          "label": "Poll interval (seconds)"
        },
        "vehicleFilter": {
          "type": "text",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "Vehicle filter",
          "help": "Part of name or VIN. Empty = all."
        },
        "apkLegacyPath": {
          "type": "text",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "Legacy APK 1.5.5 (VIN only)"
        },
        "runtimeSecretsJsonPath": {
          "type": "text",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "Runtime JSON from Frida (app 3.x only)"
        },
        "pythonBinary": {
          "type": "text",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "Python program (empty = auto)"
        },
        "alertWebhook": {
          "type": "text",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "Alert webhook https://"
        },
        "debug": {
          "type": "checkbox",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "Debug logging"
        },
        "mockMode": {
          "type": "checkbox",
          "xs": 12,
          "sm": 6,
          "md": 6,
          "lg": 6,
          "xl": 6,
          "label": "Mock mode (test without account)"
