{
  "common": {
    "name": "zeekr",
    "version": "0.1.6",
    "title": "Zeekr",
    "titleLang": {
      "en": "Zeekr",
      "de": "Zeekr"
    },
    "desc": {
      "en": "Connects Zeekr electric vehicles to ioBroker and exposes vehicle status, charging state, and control data as datapoints.",
      "de": "Verbindet Zeekr-Fahrzeuge mit ioBroker und stellt Fahrzeugstatus, Ladezustand und Steuerdaten als Datenpunkte bereit."
    },
    "authors": [
      "Fryyyyy"
    ],
    "license": "MIT",
    "platform": "Javascript/Node.js",
    "main": "main.js",
    "mode": "daemon",
    "icon": "img/zeekr.svg",
    "enabled": true,
    "extIcon": "https://raw.githubusercontent.com/solderer-de/iobroker-adapter-zeekr/main/admin/zeekr.svg",
    "readme": "https://github.com/solderer-de/iobroker-adapter-zeekr/blob/main/README.md",
    "licenseInformation": {
      "license": "MIT",
      "link": "https://github.com/solderer-de/iobroker-adapter-zeekr/blob/main/LICENSE"
    },
    "keywords": [
      "zeekr",
      "ev",
      "vehicle",
      "car",
      "iobroker"
    ],
    "tier": 2,
    "dependencies": [
      {
        "js-controller": ">=5.0.0"
      }
    ],
    "connectionType": "cloud",
    "dataSource": "poll",
    "materialize": true,
    "adminUI": {
      "config": "json"
    },
    "type": "vehicle",
    "compact": true,
    "singleton": false,
    "os": [
      "linux",
      "darwin",
      "win32"
    ],
    "serviceName": "zeekr"
  },
  "native": {
    "username": "",
    "password": "",
    "pollingInterval": 300,
    "vehicleFilter": "",
    "pythonBinary": "",
    "alertWebhook": "",
    "debug": false
  },  "objects": [],
  "instanceObjects": [
    {
      "_id": "info",
      "type": "channel",
      "common": {
        "name": "Information",
        "type": "channel"
      },
      "native": {}
    },
    {
      "_id": "vehicles",
      "type": "channel",
      "common": {
        "name": "Vehicles",
        "type": "channel"
      },
      "native": {}
    }
  ]
}
