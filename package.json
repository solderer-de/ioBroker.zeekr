{
  "name": "iobroker.zeekr",
  "version": "0.1.48",
  "description": "ioBroker adapter for Zeekr electric vehicles",
  "author": "solderer-de",
  "license": "MIT",
  "main": "main.js",
  "keywords": [
    "ioBroker",
    "zeekr",
    "ev",
    "vehicle",
    "car",
    "charging"
  ],
  "files": [
    "admin",
    "lib",
    "main.js",
    "io-package.json",
    "requirements.txt",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solderer-de/ioBroker.zeekr.git"
  },
  "homepage": "https://github.com/solderer-de/ioBroker.zeekr",
  "bugs": {
    "url": "https://github.com/solderer-de/ioBroker.zeekr/issues"
  },
  "scripts": {
    "test": "cross-env NODE_ENV=test node --test test/adapter.test.js",
    "test:package": "mocha test/package.js --exit",
    "test:integration": "mocha test/integration.js --exit --timeout 120000",
    "lint": "eslint lib/adapter.js main.js test/ scripts/ eslint.config.mjs && node --check main.js && node --check lib/adapter.js && python3 -m py_compile lib/bridge.py lib/extract_secrets.py",
    "check-versions": "node scripts/check-versions.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3"
  },
  "devDependencies": {
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.3.0",
    "@types/node": "^22.20.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5"
  }
}
